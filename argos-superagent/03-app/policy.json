      "publish-external"
    ]
  },
  "attention": {
    "chatWordLimit": 100,
    "oneAckPerTicket": true,
    "maxMessagesPerTick": 3
  },
  "workers": {
    "maxWorkers": 4,
    "timeoutTicks": 40
  },
  "watchdog": {
    "stallTicks": 6,
    "loopThreshold": 3
  },
  "evalLatencyTicks": 1,
  "reviewTicks": 3,
  "disclosure": "ARGOS automated agent \u2014 not a human."
