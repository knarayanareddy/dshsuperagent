  "speculation": {
    "enabled": true,
    "confidenceThreshold": 0.72,
    "maxPerTick": 2,
    "showcaseSpeculationInObserve": true
  },
  "autonomy": {
    "auto": [
      "read-only",
      "simulate",
      "compute",
      "draft",
      "attest-provisional"
    ],
    "approve": [
